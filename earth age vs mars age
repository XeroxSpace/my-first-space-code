"""
Earth age vs Mars age calculator.

Key numbers:
  - 1 Earth year  = 365.25 Earth days
  - 1 Mars year   = 686.98 Earth days  (how long Mars takes to orbit the Sun)
  - 1 sol (Mars day) = 24h 39m 35.244s = 88775.244 seconds
"""

from datetime import date

EARTH_YEAR_DAYS = 365.25
MARS_YEAR_DAYS = 686.98
SECONDS_PER_SOL = 88775.244
SECONDS_PER_EARTH_DAY = 86400


def days_lived(birth: date, today: date | None = None) -> int:
    today = today or date.today()
    if birth > today:
        raise ValueError("Birth date is in the future.")
    return (today - birth).days


def earth_age(days: float) -> float:
    return days / EARTH_YEAR_DAYS


def mars_age(days: float) -> float:
    return days / MARS_YEAR_DAYS


def sols_lived(days: float) -> float:
    return days * SECONDS_PER_EARTH_DAY / SECONDS_PER_SOL


def parse_date(text: str) -> date:
    y, m, d = (int(part) for part in text.strip().split("-"))
    return date(y, m, d)


def main() -> None:
    raw = input("Enter your birth date (YYYY-MM-DD): ")
    birth = parse_date(raw)
    days = days_lived(birth)

    print(f"\nDays lived on Earth : {days:,}")
    print(f"Sols (Mars days)    : {sols_lived(days):,.1f}")
    print(f"Age on Earth        : {earth_age(days):.2f} Earth years")
    print(f"Age on Mars         : {mars_age(days):.2f} Mars years")

    next_mars_bday = (int(mars_age(days)) + 1) * MARS_YEAR_DAYS - days
    print(f"\nNext Mars birthday in {next_mars_bday:.0f} Earth days.")


if __name__ == "__main__":
    main()
